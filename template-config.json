{
  "buckets": {
    "f91f5608-4755-44c0-941c-3bcd80ffb228": {
      "name": "Storage"
    }
  },
  "services": {
    "6c02e81b-826a-4a56-97f4-f0c75d43825c": {
      "icon": "https://raw.githubusercontent.com/nomideusz/morphik-railway/main/icon.svg",
      "name": "Morphik",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/ping",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/morphik-railway",
        "rootDirectory": null
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "variables": {
        "PORT": {
          "defaultValue": "8000",
          "description": "Port Morphik listens on - leave as is",
          "isOptional": false
        },
        "JWT_SECRET_KEY": {
          "defaultValue": "${{secret(64, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs every API token (morphik:// URIs). Changing it revokes all of them",
          "isOptional": false
        },
        "SESSION_SECRET_KEY": {
          "defaultValue": "${{secret(64, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs session cookies; replaces upstream's publicly known default",
          "isOptional": false
        },
        "ADMIN_SERVICE_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin secret: send it as X-Morphik-Admin-Secret to POST /cloud/generate_uri to create apps and their morphik:// URIs. Keep it private",
          "isOptional": false
        },
        "MORPHIK_API_DOMAIN": {
          "defaultValue": "${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Host written into generated morphik:// URIs - set it to your custom domain after adding one",
          "isOptional": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "OpenAI key - needed for the default models (gpt-4.1-mini answers, text-embedding-3-small embeddings)",
          "isOptional": true
        },
        "ANTHROPIC_API_KEY": {
          "defaultValue": "",
          "description": "Anthropic key, for MORPHIK_COMPLETION_MODEL=anthropic/claude-... (Anthropic has no embedding models)",
          "isOptional": true
        },
        "OPENROUTER_API_KEY": {
          "defaultValue": "",
          "description": "OpenRouter key, for MORPHIK_COMPLETION_MODEL=openrouter/<provider>/<model>",
          "isOptional": true
        },
        "OPENAI_API_BASE": {
          "defaultValue": "",
          "description": "Optional OpenAI-compatible base URL (vLLM, LiteLLM proxy, Together, ...) used for openai/ models",
          "isOptional": true
        },
        "MORPHIK_COMPLETION_MODEL": {
          "defaultValue": "gpt-4.1-mini",
          "description": "LiteLLM model for answers, document analysis and image captions, e.g. gpt-4.1-mini, anthropic/claude-sonnet-4-5, openrouter/google/gemini-2.5-flash",
          "isOptional": false
        },
        "MORPHIK_EMBEDDING_MODEL": {
          "defaultValue": "text-embedding-3-small",
          "description": "LiteLLM embedding model. Pick it before ingesting: switching later means re-ingesting",
          "isOptional": false
        },
        "MORPHIK_EMBEDDING_DIMENSIONS": {
          "defaultValue": "1536",
          "description": "Vector size of the embedding model (1536 for text-embedding-3-small); fixed once the first document is stored",
          "isOptional": false
        },
        "POSTGRES_URI": {
          "defaultValue": "postgresql+asyncpg://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Postgres (with pgvector) on the private network",
          "isOptional": false
        },
        "REDIS_HOST": {
          "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Redis on the private network (ingestion queue)",
          "isOptional": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Storage.BUCKET}}",
          "description": "Railway bucket holding uploaded files and page images",
          "isOptional": false
        },
        "AWS_ENDPOINT_URL": {
          "defaultValue": "${{Storage.ENDPOINT}}",
          "description": "Bucket S3 endpoint",
          "isOptional": false
        },
        "AWS_REGION": {
          "defaultValue": "${{Storage.REGION}}",
          "description": "Bucket region",
          "isOptional": false
        },
        "AWS_ACCESS_KEY": {
          "defaultValue": "${{Storage.ACCESS_KEY_ID}}",
          "description": "Bucket access key",
          "isOptional": false
        },
        "AWS_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Storage.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key",
          "isOptional": false
        },
        "TELEMETRY": {
          "defaultValue": "false",
          "description": "Anonymous usage telemetry to Morphik; set true to opt in",
          "isOptional": false
        },
        "LITELLM_LOCAL_MODEL_COST_MAP": {
          "defaultValue": "True",
          "description": "Use LiteLLM's bundled model price list instead of downloading it at boot",
          "isOptional": false
        },
        "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
          "defaultValue": "600",
          "description": "First boot creates the database schema before the health check can pass",
          "isOptional": false
        }
      }
    },
    "d9496e43-2e0b-409e-be0f-9cf5241b07a0": {
      "icon": "https://raw.githubusercontent.com/nomideusz/morphik-railway/main/icon.svg",
      "name": "Morphik Worker",
      "build": {},
      "deploy": {
        "startCommand": "/app/railway-entrypoint.sh arq core.workers.ingestion_worker.WorkerSettings",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/morphik-railway",
        "rootDirectory": null
      },
      "networking": {
        "serviceDomains": {}
      },
      "variables": {
        "JWT_SECRET_KEY": {
          "defaultValue": "${{Morphik.JWT_SECRET_KEY}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "SESSION_SECRET_KEY": {
          "defaultValue": "${{Morphik.SESSION_SECRET_KEY}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "${{Morphik.OPENAI_API_KEY}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "ANTHROPIC_API_KEY": {
          "defaultValue": "${{Morphik.ANTHROPIC_API_KEY}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "OPENROUTER_API_KEY": {
          "defaultValue": "${{Morphik.OPENROUTER_API_KEY}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "OPENAI_API_BASE": {
          "defaultValue": "${{Morphik.OPENAI_API_BASE}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "MORPHIK_COMPLETION_MODEL": {
          "defaultValue": "${{Morphik.MORPHIK_COMPLETION_MODEL}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "MORPHIK_EMBEDDING_MODEL": {
          "defaultValue": "${{Morphik.MORPHIK_EMBEDDING_MODEL}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "MORPHIK_EMBEDDING_DIMENSIONS": {
          "defaultValue": "${{Morphik.MORPHIK_EMBEDDING_DIMENSIONS}}",
          "description": "Same as the Morphik service - edit it there",
          "isOptional": false
        },
        "POSTGRES_URI": {
          "defaultValue": "postgresql+asyncpg://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Postgres (with pgvector) on the private network",
          "isOptional": false
        },
        "REDIS_HOST": {
          "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Redis on the private network (ingestion queue)",
          "isOptional": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Storage.BUCKET}}",
          "description": "Railway bucket holding uploaded files and page images",
          "isOptional": false
        },
        "AWS_ENDPOINT_URL": {
          "defaultValue": "${{Storage.ENDPOINT}}",
          "description": "Bucket S3 endpoint",
          "isOptional": false
        },
        "AWS_REGION": {
          "defaultValue": "${{Storage.REGION}}",
          "description": "Bucket region",
          "isOptional": false
        },
        "AWS_ACCESS_KEY": {
          "defaultValue": "${{Storage.ACCESS_KEY_ID}}",
          "description": "Bucket access key",
          "isOptional": false
        },
        "AWS_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Storage.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key",
          "isOptional": false
        },
        "TELEMETRY": {
          "defaultValue": "${{Morphik.TELEMETRY}}",
          "description": "Anonymous usage telemetry to Morphik; set true to opt in",
          "isOptional": false
        },
        "LITELLM_LOCAL_MODEL_COST_MAP": {
          "defaultValue": "True",
          "description": "Use LiteLLM's bundled model price list instead of downloading it at boot",
          "isOptional": false
        }
      }
    },
    "bdeff664-8d9a-4a2b-a0e8-952a99387b27": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "pgvector/pgvector:0.8.7-pg17"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "5ee04dd8-0d1f-4691-9bae-de4f302eb301": {
          "mountPath": "/var/lib/postgresql/data"
        }
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "morphik",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "morphik",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      }
    },
    "7fccb25c-dbf4-4a5d-84c0-5922367bf677": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"chown -R redis:redis /data && exec docker-entrypoint.sh redis-server --appendonly yes\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "9882a01e-9173-42d6-bc17-9c0e6774e758": {
          "mountPath": "/data"
        }
      },
      "variables": {}
    }
  }
}